<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 版本：每交付一版 +0.0.1（顯示在「關於」）。P0=0.0.1 … P4=0.0.4，微調=0.0.5 -->
    <Version>1.1.5</Version>
    <AssemblyTitle>AwayTerminal</AssemblyTitle>
    <Company>Chih-Wei Su (Awaysu)</Company>
    <Copyright>Copyright (c) 2026 Chih-Wei Su (Awaysu)</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="System.IO.Ports" Version="10.0.10" />
  </ItemGroup>

  <!-- 開啟 WinForms 只為了用系統顏色選擇器；移除其全域 using 以免與 WPF 的 Brush/TextBox/Application 撞名 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- 把 web/（xterm.js 前端）複製到輸出目錄，供 WebView2 以本地虛擬主機載入 -->
  <ItemGroup>
    <Content Include="web\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- v1.0.13 起不再打包 Google 的 adb（見 AppSettings.ResolveAdbPath 與
       THIRD-PARTY-NOTICES.md）：Android SDK 條款 §3.4 禁止轉散布，與 §3.5 的
       開源元件例外界線不明，上架 Store 需對散布內容有明確權利。改為搜尋使用者
       既有的 platform-tools 安裝。 -->

  <!-- 1.1.3：Windows Terminal 的新版 ConPTY 主機（conpty.dll + OpenConsole.exe，MIT、微軟簽章；
       來源與雜湊見 third_party/conpty/README.md）→ 輸出目錄 conpty\，ConPty/ConptyDll.cs 啟動時載入；
       缺檔就退回 kernel32 內建 conhost。安裝檔／MSIX 都打包 bin\publish\* 子目錄，自動含入。 -->
  <ItemGroup>
    <Content Include="third_party\conpty\conpty.dll;third_party\conpty\OpenConsole.exe">
      <Link>conpty\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 工具列 / 視窗 icon 內嵌為 WPF 資源 -->
  <ItemGroup>
    <Resource Include="icon\*.png" Exclude="icon\png-preview.png" />
  </ItemGroup>

  <!-- 授權聲明隨程式一起發佈：MIT 等授權要求「所有副本」都要附上聲明，
       只放在 repo 不算數。放進輸出目錄後，Inno 安裝檔（打包 bin\publish\*）
       與 MSIX（複製 bin\publish\*）兩邊都會自動含入，不必各自維護。 -->
  <ItemGroup>
    <Content Include="LICENSE;THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- build 後自動用自簽憑證簽章 exe（找不到憑證會安靜略過，不中斷 build）-->
  <Target Name="SignOutput" AfterTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)sign.ps1&quot; &quot;$(TargetDir)$(TargetName).exe&quot;"
          ContinueOnError="true" />
  </Target>

</Project>
