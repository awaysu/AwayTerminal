<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 版本：每交付一版 +0.0.1（顯示在「關於」）。P0=0.0.1 … P4=0.0.4，微調=0.0.5 -->
    <Version>1.0.4</Version>
    <AssemblyTitle>AwayTerminal</AssemblyTitle>
    <Company>awaysu@gmail.com</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="System.IO.Ports" Version="10.0.10" />
  </ItemGroup>

  <!-- 開啟 WinForms 只為了用系統顏色選擇器；移除其全域 using 以免與 WPF 的 Brush/TextBox/Application 撞名 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- 把 web/（xterm.js 前端）複製到輸出目錄，供 WebView2 以本地虛擬主機載入 -->
  <ItemGroup>
    <Content Include="web\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 內建打包 adb（adb.exe + 相依 DLL）→ 使用者不必自行選 adb 路徑 -->
  <ItemGroup>
    <Content Include="tools\adb\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 工具列 / 視窗 icon 內嵌為 WPF 資源 -->
  <ItemGroup>
    <Resource Include="icon\*.png" Exclude="icon\png-preview.png" />
  </ItemGroup>

  <!-- build 後自動用自簽憑證簽章 exe（找不到憑證會安靜略過，不中斷 build）-->
  <Target Name="SignOutput" AfterTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)sign.ps1&quot; &quot;$(TargetDir)$(TargetName).exe&quot;"
          ContinueOnError="true" />
  </Target>

</Project>
