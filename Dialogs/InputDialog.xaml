<Window x:Class="AwayTerminal.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AwayTerminal" SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#2D2D30">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Foreground="#E0E0E0" Margin="0,0,0,8" TextWrapping="Wrap" Text="請輸入：" />
        <TextBox x:Name="Input" Padding="4" Background="#1E1E1E" Foreground="#E0E0E0"
                 BorderBrush="#555" CaretBrush="#E0E0E0" FontSize="14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkBtn" Content="確定" Width="72" Height="26" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0" />
            <Button x:Name="CancelBtn" Content="取消" Width="72" Height="26" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
