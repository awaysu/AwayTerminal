<Window x:Class="AwayTerminal.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AwayTerminal" SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#2D2D30">
    <!-- Grid（不是 StackPanel）：多行模式視窗可拉大時，輸入框那一列才跟著長高 -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Grid.Row="0" Foreground="#E0E0E0" Margin="0,0,0,8" TextWrapping="Wrap" Text="請輸入：" />
        <TextBox x:Name="Input" Grid.Row="1" Padding="4" Background="#1E1E1E" Foreground="#E0E0E0"
                 BorderBrush="#555" CaretBrush="#E0E0E0" FontSize="14" />
        <!-- 多行模式才顯示：Enter 換行、Ctrl+Enter 確定 -->
        <TextBlock x:Name="HintText" Grid.Row="2" Foreground="#9A9A9A" FontSize="11" Margin="0,6,0,0" Visibility="Collapsed" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkBtn" Content="確定" Width="72" Height="26" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0" />
            <Button x:Name="CancelBtn" Content="取消" Width="72" Height="26" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
