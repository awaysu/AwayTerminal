<Window x:Class="AwayTerminal.Dialogs.MultiAgentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="代理團隊" Width="720" SizeToContent="Height"
        Background="#2D2D30" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#555" />
            <Setter Property="CaretBrush" Value="#E0E0E0" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Height" Value="27" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 下拉選單內文字用黑色：擋掉視窗層級的灰字 TextBlock 隱式樣式滲入 ComboBox 模板（踩雷「深色對話框的 ComboBox 灰字」）-->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="Black" />
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16,14,16,14">
        <!-- 專案資料夾在開視窗前就選好了（同其他「啟動前選擇資料夾」的連線），這裡不再有資料夾欄位；視窗標題顯示完整路徑 -->

        <!-- 投遞限制次數、閒置檢查（整組一個值；Agent-x1 那格的正上方，左邊對齊格子外框）-->
        <DockPanel Margin="4,0,4,6">
            <TextBlock x:Name="LimitLabel" Text="投遞限制次數" Margin="0,0,10,0" />
            <ComboBox x:Name="LimitBox" Width="110" />
            <TextBlock x:Name="LimitHint" Foreground="#9A9A9A" FontSize="11" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <DockPanel Margin="4,0,4,8">
            <TextBlock x:Name="IdleLabel" Text="閒置檢查" Margin="0,0,10,0" />
            <ComboBox x:Name="IdleBox" Width="110" />
            <TextBlock x:Name="IdleHint" Foreground="#9A9A9A" FontSize="11" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- 四格（2×2）：Agent-x1 Agent-x2 / Agent-x3 Agent-x4；外框顏色＝終端機裡的 pane 外框 -->
        <UniformGrid x:Name="SlotGrid" Rows="2" Columns="2" />

        <TextBlock x:Name="NoBackendText" Foreground="#EF9A9A" TextWrapping="Wrap" Margin="4,8,4,0" Visibility="Collapsed" />
        <TextBlock x:Name="HintText" Foreground="#9A9A9A" FontSize="11" TextWrapping="Wrap" Margin="4,8,4,0" />

        <DockPanel Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="RestoreRolesBtn" Content="還原角色檔預設" Height="30" Padding="10,0" Margin="0,0,8,0" Click="RestoreRoles_Click" />
                <Button x:Name="OpenRolesBtn" Content="開啟角色檔資料夾" Height="30" Padding="10,0" Click="OpenRoles_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkBtn" Content="開啟" Width="88" Height="30" IsDefault="True" Margin="0,0,8,0" Click="Ok_Click" />
                <Button x:Name="CancelBtn" Content="取消" Width="88" Height="30" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
