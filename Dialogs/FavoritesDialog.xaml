<Window x:Class="AwayTerminal.Dialogs.FavoritesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="我的最愛" Width="560" Height="440" MinWidth="420" MinHeight="300"
        Background="#2D2D30" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#555" />
            <Setter Property="CaretBrush" Value="#E0E0E0" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- 我的最愛設定（2026-09-16）：左邊清單（圖示＋名稱＋連線種類／位置），下面改名稱、刪除 -->
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox x:Name="List" Grid.Row="0" Background="#1E1E1E" BorderBrush="#555" Foreground="#E0E0E0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="List_SelectionChanged" />
        <TextBlock x:Name="EmptyText" Grid.Row="0" Foreground="#9A9A9A" TextWrapping="Wrap" Margin="14"
                   VerticalAlignment="Top" Visibility="Collapsed" />

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock x:Name="NameLabel" DockPanel.Dock="Left" Text="名稱" Margin="0,0,10,0" />
            <Button x:Name="RenameBtn" DockPanel.Dock="Right" Content="修改名稱" Height="28" Padding="12,0" Margin="8,0,0,0"
                    IsDefault="True" Click="Rename_Click" />
            <TextBox x:Name="NameBox" />
        </DockPanel>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="DeleteBtn" DockPanel.Dock="Left" Content="刪除" Width="88" Height="30" Click="Delete_Click" />
            <Button x:Name="CloseBtn" Content="關閉" Width="88" Height="30" HorizontalAlignment="Right" IsCancel="True" />
        </DockPanel>
    </Grid>
</Window>
