<Window x:Class="AwayTerminal.Dialogs.OpenDirDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="開 PowerShell" Width="500" SizeToContent="Height"
        Background="#2D2D30" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="工作目錄（開啟後 PowerShell 會在此目錄）：" Foreground="#E0E0E0" Margin="0,0,0,6" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="新增目錄…" Width="90" Height="24" Margin="8,0,0,0" Click="Add_Click" />
            <ComboBox x:Name="DirCombo" IsEditable="True" Height="24" />
        </DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="確定" Width="76" Height="26" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0" />
            <Button Content="取消" Width="76" Height="26" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
