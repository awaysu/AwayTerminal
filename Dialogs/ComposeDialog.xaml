<Window x:Class="AwayTerminal.Dialogs.ComposeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AwayTerminal" Width="700" Height="440" MinWidth="480" MinHeight="280"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Background="#2D2D30">
    <!-- 1.2.7 精簡（使用者要求）：常用字串功能整個移除；上方一列「載入文字檔 · 清除 · 復原 · 儲存」文字連結，
         中間輸入框，下方「送出後送 Enter」＋返回／送出（唯一強調色按鈕）。 -->
    <Window.Resources>
        <!-- 主要按鈕：藍底白字 -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0E639C" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1177BB" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#0B4F7D" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3D" />
                                <Setter Property="Foreground" Value="#808080" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 次要按鈕：深灰底細框 -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Background" Value="#3E3E42" />
            <Setter Property="BorderBrush" Value="#555" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#4A4A4F" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#333336" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 文字連結按鈕：次要操作 -->
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#9CC8F0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="2,2">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#CFE6FF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16,12,16,14">
        <!-- 上：載入文字檔（1.1.10）／清除／復原（Ctrl+Z 同效）／儲存（1.2.7，另存成文字檔）-->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="LoadFileBtn" Style="{StaticResource LinkBtn}" Click="LoadFile_Click" />
            <TextBlock Text="·" Foreground="#666" Margin="8,0" VerticalAlignment="Center" />
            <Button x:Name="ClearBtn" Style="{StaticResource LinkBtn}" Click="Clear_Click" />
            <TextBlock Text="·" Foreground="#666" Margin="8,0" VerticalAlignment="Center" />
            <Button x:Name="UndoBtn" Style="{StaticResource LinkBtn}" Click="Undo_Click" />
            <TextBlock Text="·" Foreground="#666" Margin="8,0" VerticalAlignment="Center" />
            <Button x:Name="SaveBtn" Style="{StaticResource LinkBtn}" Click="Save_Click" />
        </StackPanel>

        <!-- 下：送出後送 Enter ＋ 返回／送出 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <CheckBox x:Name="SendEnterChk" DockPanel.Dock="Left" Foreground="#E0E0E0" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackBtn" Style="{StaticResource SecondaryBtn}" MinWidth="80" Height="30" Padding="12,0"
                        IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="SendBtn" Style="{StaticResource PrimaryBtn}" MinWidth="96" Height="30" Padding="14,0"
                        Click="Send_Click" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <!-- 一般 TextBox：IME 在這裡組字、提交，完全不經 xterm／ConPTY／claude 的逐鍵解析 -->
            <TextBox x:Name="Input" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="8,6" FontSize="14"
                     FontFamily="Cascadia Mono, Consolas, Microsoft JhengHei, 微軟正黑體"
                     Background="#1E1E1E" Foreground="#E0E0E0" BorderBrush="#555" CaretBrush="#E0E0E0"
                     TextChanged="Input_TextChanged" />
            <!-- 空白時的提示字 -->
            <TextBlock x:Name="Placeholder" IsHitTestVisible="False" Margin="11,7,11,0" FontSize="14"
                       Foreground="#6A6A6A" TextWrapping="Wrap" VerticalAlignment="Top" />
        </Grid>
    </DockPanel>
</Window>
