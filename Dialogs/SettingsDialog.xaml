<Window x:Class="AwayTerminal.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Width="470" SizeToContent="Height"
        Background="#2D2D30" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#555" />
            <Setter Property="CaretBrush" Value="#E0E0E0" />
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="Height" Value="24" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#CFCFCF" />
            <Setter Property="BorderBrush" Value="#555" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <!-- 語言 -->
        <GroupBox x:Name="LangGroup" Header="語言">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ZhRadio" Content="中文" Foreground="#E0E0E0" Margin="4,0,16,0" />
                <RadioButton x:Name="EnRadio" Content="English" Foreground="#E0E0E0" />
            </StackPanel>
        </GroupBox>

        <!-- 字體背景顏色 -->
        <GroupBox x:Name="FontGroup" Header="字體背景顏色">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" x:Name="FamilyLabel" Text="字型" Margin="0,0,10,0" />
                <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="FontCombo" IsEditable="True" Height="24" Margin="0,4" />

                <TextBlock Grid.Row="1" Grid.Column="0" x:Name="SizeLabel" Text="大小" Margin="0,0,10,0" />
                <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="SizeCombo" IsEditable="True" Height="24" Margin="0,4" />

                <TextBlock Grid.Row="2" Grid.Column="0" x:Name="FgLabel" Text="文字顏色" Margin="0,0,10,0" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="FgBox" Margin="0,4" TextChanged="Fg_Changed" />
                <Border Grid.Row="2" Grid.Column="2" x:Name="FgPreview" Width="24" Height="24" Margin="8,4,0,4"
                        BorderBrush="#555" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="FgPreview_Click" />

                <TextBlock Grid.Row="3" Grid.Column="0" x:Name="BgLabel" Text="背景顏色" Margin="0,0,10,0" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="BgBox" Margin="0,4" TextChanged="Bg_Changed" />
                <Border Grid.Row="3" Grid.Column="2" x:Name="BgPreview" Width="24" Height="24" Margin="8,4,0,4"
                        BorderBrush="#555" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="BgPreview_Click" />
            </Grid>
        </GroupBox>

        <!-- 註：ADB 的設定已於 v1.0.18 移除。ADB 改由「新連接 → 自訂…」管理
             （自訂視窗的「自動偵測」可一鍵加入），路徑也由該筆自訂連線決定。 -->

        <!-- Claude 分頁：注音/輸入送出的靜止閘門（1.0.43） -->
        <GroupBox x:Name="ImeGroup" Header="Claude 輸入送出">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="ImeQuietLabel" Text="送出前等待靜止 (ms)" Margin="0,0,10,0" />
                <TextBox Grid.Column="1" x:Name="ImeQuietBox" MaxLength="3" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Hyperlink x:Name="ImeHelpLink" Click="ImeHelp_Click" Foreground="#4EA6FF"
                               TextDecorations="Underline">這是什麼？</Hyperlink>
                </TextBlock>
            </Grid>
        </GroupBox>

        <!-- 檔案總管右鍵選單「用 AwayTerminal 開啟」（1.0.45；HKCU，見 ShellIntegration） -->
        <GroupBox x:Name="ShellGroup" Header="檔案總管">
            <CheckBox x:Name="ShellMenuCheck" Content="資料夾右鍵選單加入「用 AwayTerminal 開啟」" Foreground="#E0E0E0" Margin="2,2" />
        </GroupBox>

        <DockPanel>
            <Button x:Name="ResetBtn" DockPanel.Dock="Left" Content="回到預設" Width="100" Height="26"
                    HorizontalAlignment="Left" Click="Reset_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkBtn" Content="確定" Width="76" Height="26" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0" />
                <Button x:Name="CancelBtn" Content="取消" Width="76" Height="26" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
