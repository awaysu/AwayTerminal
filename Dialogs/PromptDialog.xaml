<Window x:Class="AwayTerminal.Dialogs.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AwayTerminal.Dialogs"
        Title="常用字串" Width="680" Height="500"
        Background="#2D2D30" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="580" MinHeight="420" ShowInTaskbar="False">
    <Window.Resources>
        <local:GroupHeaderConverter x:Key="GroupHeader" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#555" />
            <Setter Property="CaretBrush" Value="#E0E0E0" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：分組清單，最下方「＋ 新增 / － 刪除」 -->
        <DockPanel Grid.Column="0" Background="#232326">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,5,0,5">
                <Button x:Name="AddBtn" Content="＋ 新增" Height="32" Margin="8,3,8,3" Click="Add_Click" Cursor="Hand" FontSize="13" />
                <Button x:Name="DeleteBtn" Content="－ 刪除" Height="32" Margin="8,3,8,3" Click="Delete_Click" Cursor="Hand" FontSize="13" />
                <Grid Margin="8,3,8,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackupBtn" Grid.Column="0" Content="備份" Height="30" Margin="0,0,3,0" Click="Backup_Click" Cursor="Hand" FontSize="12" />
                    <Button x:Name="LoadBtn" Grid.Column="1" Content="載入" Height="30" Margin="3,0,0,0" Click="Load_Click" Cursor="Hand" FontSize="12" />
                </Grid>
            </StackPanel>
            <ListBox x:Name="TitleList" DisplayMemberPath="Title" SelectionChanged="List_SelectionChanged"
                     Background="Transparent" Foreground="#E0E0E0" BorderThickness="0" Padding="4" FontSize="13">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <Expander IsExpanded="True" Foreground="#C9C9C9" Background="Transparent" BorderThickness="0" Margin="0,2,0,0">
                                                <Expander.Header>
                                                    <TextBlock Text="{Binding Name, Converter={StaticResource GroupHeader}}"
                                                               Foreground="#B9C6A9" FontWeight="SemiBold" FontSize="12">
                                                        <TextBlock.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="群組改名" Click="GroupRename_Click" />
                                                                <MenuItem Header="刪除群組" Click="GroupDelete_Click" />
                                                            </ContextMenu>
                                                        </TextBlock.ContextMenu>
                                                    </TextBlock>
                                                </Expander.Header>
                                                <ItemsPresenter Margin="10,0,0,0" />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>
        </DockPanel>

        <!-- 右：群組 / 標題 / 內容 + 右下 送出/儲存/返回 -->
        <Grid Grid.Column="1" Margin="18,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="GroupLabel" Text="群組" />
                <ComboBox Grid.Row="1" x:Name="GroupCombo" IsEditable="True" Height="27" Margin="0,4,0,12" />
                <TextBlock Grid.Row="2" x:Name="TitleLabel" Text="標題" />
                <TextBox Grid.Row="3" x:Name="TitleBox" Height="27" Margin="0,4,0,12" />
                <TextBlock Grid.Row="4" x:Name="ContentLabel" Text="內容" />
                <TextBox Grid.Row="5" x:Name="ContentBox" Margin="0,4,0,0"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,12,0,0">
                <Button x:Name="SendBtn" Content="送出" Width="84" Height="30" Click="Send_Click" IsDefault="True" Margin="0,0,8,0" />
                <Button x:Name="SaveBtn" Content="儲存" Width="84" Height="30" Click="Save_Click" Margin="0,0,8,0" />
                <Button x:Name="BackBtn" Content="返回" Width="84" Height="30" Click="Back_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
