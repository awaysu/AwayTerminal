; 舊版 AwayTerminal 的 `samples/sample.ttl` **整檔**（含連線的部分）。
;
; 只有兩處改動，都標在旁邊：
;   1. `wait 'PS'` 改成等測試 server 的提示字元（那台不是 PowerShell）
;   2. 最後的 `messagebox` 留著——ttl_probe 的假 host 會自動回答
; 其餘一字不改，用來證明「舊版寫的巨集在新版跑得起來」。

sendln 'echo === macro start ==='
mpause 300

; --- for 迴圈 + int2str（把數字轉字串再送出）---
for i 1 3
  int2str istr i
  sendln 'echo loop ' istr
  mpause 200
next

; --- 變數、運算式、if/then/else/endif ---
a = 2
b = 3
c = a + b
int2str cstr c
sendln 'echo a+b = ' cstr
if c = 5 then
  sendln 'echo c equals 5 (correct)'
else
  sendln 'echo unexpected'
endif

; --- 等提示字元出現再繼續 ---
; 舊版是 `wait 'PS'`（PowerShell 的提示字元）；測試 server 回的是 OK-DONE
wait 'OK-DONE'
sendln 'echo === macro done ==='

; --- 對話框（result 會被 yesnobox 設定）---
messagebox '巨集執行完畢!' 'AwayTerminal'
